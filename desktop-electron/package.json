{
  "name": "nai-studio-desktop",
  "productName": "NAI Studio",
  "version": "3.0.0",
  "description": "NAI Studio — Obsidian Atelier Native Desktop Workbench for NovelAI V5/V4.5, Studio Agent, MCP & A2A",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "pack": "electron-builder --win dir",
    "dist:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.naistudio.desktop",
    "productName": "NAI Studio",
    "directories": {
      "output": "../dist-desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/nai_studio.ico",
      "executableName": "NAI Studio"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
